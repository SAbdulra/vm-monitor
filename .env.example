# VM Monitor - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ==================== Database Configuration ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infra_monitor
DB_USER=vm_monitor
DB_PASSWORD=your_secure_password_here

# Telegraf database user
TELEGRAF_PASSWORD=your_telegraf_password_here

# ==================== Application Settings ====================
LOG_LEVEL=INFO

# ==================== Optional: Redis Configuration ====================
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ==================== Optional: CVE Downloader ====================
# Cron schedule for CVE sync (default: 2 AM daily)
CRON_SCHEDULE=0 2 * * *

# ==================== Optional: NVD API Key ====================
# Get your key from: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=your_nvd_api_key_here

# ==================== Optional: LDAP/AD Authentication ====================
# LDAP_SERVER=ldap://your-ad-server.example.com
# LDAP_PORT=389
# LDAP_DOMAIN=EXAMPLE
# LDAP_BASE_DN=DC=example,DC=com

# ==================== JWT Configuration (for authentication) ====================
JWT_SECRET_KEY=CHANGE_THIS_SECRET_KEY  # Generate with: openssl rand -hex 32
JWT_EXPIRE_MINUTES=480  # Token expiration in minutes (480 = 8 hours)

# ==================== Optional: Performance Tuning ====================
# Number of uvicorn workers for backend
# WORKERS=2

# PostgreSQL connection pool size
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# Redis memory limit
# REDIS_MAX_MEMORY=256mb
